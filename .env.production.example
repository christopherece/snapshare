# Production settings for docker-compose.prod.yml.
# On the VPS:  cp .env.production.example .env   then fill in every CHANGE_ME.
# Generate secrets with:  openssl rand -hex 32

# ─── Your domains ─────────────────────────────────────────────
PUBLIC_APP_URL=https://snap.example.com
# What the QR code encodes: the guest web app (served by the backend at /join/<code>).
GUEST_JOIN_URL=https://snap.example.com/join/{slug}
# Where the "open in the app instead" link sends guests who installed the native app.
APP_LINK_TEMPLATE=snapshare://join/{slug}
SLIDESHOW_URL=https://snap.example.com/slideshow

# ─── Secrets ──────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# ─── Photo storage (RustFS container) ─────────────────────────
S3_REGION=us-east-1
S3_BUCKET=snapshare-media
S3_ACCESS_KEY_ID=snapshare
S3_SECRET_ACCESS_KEY=CHANGE_ME
# Public address phones upload to / load photos from (nginx → RustFS).
S3_PRESIGN_ENDPOINT=https://media.example.com
S3_PUBLIC_URL=https://media.example.com/snapshare-media

# ─── Tuning ───────────────────────────────────────────────────
# Image-processing threads. 1 per ~512 MB of spare RAM; 2 is fine on a 2 GB VPS.
MEDIA_WORKERS=2
UPLOADS_PER_MINUTE=30
MAX_UPLOAD_BYTES=15728640

# Host ports (bound to 127.0.0.1; nginx proxies to them). Change if already in use.
BACKEND_PORT=3030
S3_PORT=9000
