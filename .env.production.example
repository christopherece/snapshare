# Production settings for docker-compose.prod.yml.
# On the VPS:  cp .env.production.example .env   then fill in every CHANGE_ME.
# Generate secrets with:  openssl rand -hex 32

# ─── Your domains ─────────────────────────────────────────────
PUBLIC_APP_URL=https://snap.topitsolutions.co.nz
# What the QR code encodes: the guest web app (served by the backend at /join/<code>).
GUEST_JOIN_URL=https://snap.topitsolutions.co.nz/join/{slug}
# Where the "open in the app instead" link sends guests who installed the native app.
APP_LINK_TEMPLATE=snapshare://join/{slug}
SLIDESHOW_URL=https://snap.topitsolutions.co.nz/slideshow

# ─── Secrets ──────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# ─── Photo storage (RustFS container) ─────────────────────────
S3_REGION=us-east-1
S3_BUCKET=snapshare-media
S3_ACCESS_KEY_ID=snapshare
S3_SECRET_ACCESS_KEY=CHANGE_ME
# Public address phones upload to / load photos from (nginx → RustFS).
S3_PRESIGN_ENDPOINT=https://snap-media.topitsolutions.co.nz
S3_PUBLIC_URL=https://snap-media.topitsolutions.co.nz/snapshare-media

# ─── Tuning ───────────────────────────────────────────────────
# Image-processing threads. 1 per ~512 MB of spare RAM; 2 is fine on a 2 GB VPS.
MEDIA_WORKERS=2
UPLOADS_PER_MINUTE=30
MAX_UPLOAD_BYTES=15728640

# CPU without AVX? (check: grep -c avx2 /proc/cpuinfo → 0) Uncomment both lines to use Bun's no-AVX build.
# BUN_VERSION=1.2.23
# BUN_BASELINE=1

# Address the ports below listen on. 127.0.0.1 = only nginx on this server can reach them.
# Using Nginx Proxy Manager (runs in Docker)? Set 172.17.0.1 and forward to 172.17.0.1:<port> in NPM.
BIND_ADDRESS=127.0.0.1
# Host ports (nginx proxies to them). Change if already in use.
BACKEND_PORT=3030
S3_PORT=9030
