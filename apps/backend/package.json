{
  "name": "@snapshare/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:studio": "bun --bun drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@snapshare/shared": "workspace:*",
    "client-zip": "^2.5.0",
    "drizzle-orm": "^0.44.5",
    "exifr": "^7.1.3",
    "hono": "^4.9.8",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.2.22",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.9.3"
  }
}
