PORT=3000
# Public base URL of this API — used to build QR code links and flyers.
PUBLIC_APP_URL=http://localhost:3000
# What the QR code encodes (must be http/https so any phone camera opens it). {slug} is replaced.
GUEST_JOIN_URL=http://localhost:3000/join/{slug}
# Where the join page sends guests. Expo Go in dev: exp://<LAN-IP>:8081/--/join/{slug}
APP_LINK_TEMPLATE=snapshare://join/{slug}
SLIDESHOW_URL=http://localhost:5173

DATABASE_URL=postgres://snapshare:snapshare@localhost:5433/snapshare
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# S3-compatible storage (AWS S3, Cloudflare R2, DO Spaces, MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=snapshare-media
S3_ACCESS_KEY_ID=snapshare
S3_SECRET_ACCESS_KEY=snapshare-secret
# Public (CDN) base URL for the bucket. Objects under public/ must be world-readable.
# NOTE: on a physical phone, use your machine's LAN IP instead of localhost.
S3_PUBLIC_URL=http://localhost:9000/snapshare-media

# Upload limits
MAX_UPLOAD_BYTES=15728640
UPLOADS_PER_MINUTE=30
MEDIA_WORKERS=2
