# The SnapShare server the app talks to. It is baked into the JavaScript bundle at build time.
# Local development: your computer's LAN IP (on a phone, "localhost" is the phone itself).
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
# Store builds use the value in eas.json (build.preview.env / build.production.env) instead.

# Optional. The domain whose https://<host>/join/<code> links should open the app.
# Defaults to the host of EXPO_PUBLIC_API_URL when that is https.
# EXPO_PUBLIC_LINK_HOST=snap.topitsolutions.co.nz

# Optional. Where "Delete my account" requests are emailed (defaults to the operator's contact address).
# EXPO_PUBLIC_SUPPORT_EMAIL=you@example.com

# Set by `eas init` (only needed for EAS builds).
# EAS_PROJECT_ID=
